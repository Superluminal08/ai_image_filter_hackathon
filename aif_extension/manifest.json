{
    "manifest_version": 3,
    "name": "AI Image Filter",
    "version": "1.0",
    "description": "An extension designed to check if images on google images for ai and flag them accordingly. May produce false",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        }    
    },
    "content_scripts" : [
        {
            "matches" : ["<all_urls>"],
            "js" : ["content.js"]
        }
    ]
        
}